  file_change {
    absolute_path_uri: "file:///src/components/Dashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { MapPin, Calendar, Plus, MessageSquare, AlertCircle, Sparkles, CheckCircle2, XCircle } from \'lucide-react\';\nimport { LoggedItem, Match, User as UserType } from \'../types\';\n\ninterface DashboardProps {\n  currentUser: UserType;\n  items: LoggedItem[];\n  matches: Match[];\n  onStartReporting: (type: \'lost\' | \'found\') => void;\n  onEditItem: (item: LoggedItem) => void;\n  onUpdateMatchStatus: (matchId: string, status: \'confirmed\' | \'rejected\') => void;\n  onOpenChat: (chatId: string) => void;\n}\n\nexport default function Dashboard({\n  currentUser,\n  items,\n  matches,\n  onStartReporting,\n  onEditItem,\n  onUpdateMatchStatus,\n  onOpenChat\n}: DashboardProps) {\n  const [activeTab, setActiveTab] = useState<\'logged-items\' | \'matches\'>(\'logged-items\');\n\n  // Filter items logged by the current user\n  const myItems = items.filter(item => item.userId === currentUser.id);\n\n  // Filter matches related to the user\'s items\n  const myMatches = matches.filter(match => \n    myItems.some(item => item.id === match.userItemId)\n  );\n\n  const pendingMatchesCount = myMatches.filter(m => m.status === \'pending\').length;\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-6 py-10 space-y-8\">\n      {/* Dashboard Welcome Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n        <div>\n          <h1 className=\"text-3xl font-extrabold tracking-tight text-gray-900\">Dashboard</h1>\n          <p className=\"text-sm text-gray-500 mt-1\">Welcome back, Mr Alex</p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => onStartReporting(\'lost\')}\n            className=\"px-5 py-2.5 bg-[#2563EB] hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-all shadow-sm hover:shadow-md cursor-pointer\"\n          >\n            Report Lost Item\n          </button>\n          <button\n            onClick={() => onStartReporting(\'found\')}\n            className=\"px-5 py-2.5 bg-[#00B050] hover:bg-green-700 text-white text-sm font-semibold rounded-xl transition-all shadow-sm hover:shadow-md cursor-pointer\"\n          >\n            Report Found Item\n          </button>\n        </div>\n      </div>\n\n      {/* Main Tabbed Container */}\n      <div className=\"bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden\">\n        {/* Tab Headers */}\n        <div className=\"flex border-b border-gray-100 justify-between items-center px-6\">\n          <div className=\"flex\">\n            <button\n              onClick={() => setActiveTab(\'logged-items\')}\n              className={`py-4 px-6 text-sm font-semibold border-b-2 transition-all cursor-pointer relative ${\n                activeTab === \'logged-items\'\n                  ? \'border-blue-600 text-blue-600\'\n                  : \'border-transparent text-gray-500 hover:text-gray-800\'\n              }`}\n            >\n              My Logged Items ({myItems.length})\n            </button>\n            <button\n              id=\"tab-matches-trigger\"\n              onClick={() => setActiveTab(\'matches\')}\n              className={`py-4 px-6 text-sm font-semibold border-b-2 transition-all cursor-pointer flex items-center gap-2 ${\n                activeTab === \'matches\'\n                  ? \'border-blue-600 text-blue-600\'\n                  : \'border-transparent text-gray-500 hover:text-gray-800\'\n              }`}\n            >\n              Matches\n              {pendingMatchesCount > 0 && (\n                <span className=\"bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full\">\n                  1 New\n                </span>\n              )}\n            </button>\n          </div>\n          <div className=\"text-xs font-mono text-gray-400 hidden sm:block\">\n            Student ID: {currentUser.matricNumber}\n          </div>\n        </div>\n\n        {/* Tab Content Panels */}\n        <div className=\"p-6 bg-[#FAFAFA]/50 min-h-[300px]\">\n          {activeTab === \'logged-items\' ? (\n            /* MY LOGGED ITEMS TAB */\n            myItems.length === 0 ? (\n              <div className=\"flex flex-col items-center justify-center py-16 text-center space-y-4\">\n                <AlertCircle className=\"w-12 h-12 text-gray-300\" />\n                <div>\n                  <h3 className=\"font-bold text-gray-800\">No items logged yet</h3>\n                  <p className=\"text-sm text-gray-400 mt-1 max-w-xs\">Have you lost or found something on campus? Log it now to start finding matches.</p>\n                </div>\n                <div className=\"flex gap-2\">\n                  <button \n                    onClick={() => onStartReporting(\'lost\')}\n                    className=\"px-4 py-2 bg-blue-50 text-blue-600 hover:bg-blue-100 text-xs font-semibold rounded-lg transition-colors cursor-pointer\"\n                  >\n                    Log Lost Item\n                  </button>\n                  <button \n                    onClick={() => onStartReporting(\'found\')}\n                    className=\"px-4 py-2 bg-green-50 text-green-600 hover:bg-green-100 text-xs font-semibold rounded-lg transition-colors cursor-pointer\"\n                  >\n                    Log Found Item\n                  </button>\n                </div>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                {myItems.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"bg-white rounded-xl border border-gray-100 p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between relative\"\n                  >\n                    {/* Badge Actions Row */}\n                    <div className=\"flex justify-between items-start mb-4\">\n                      <div className=\"flex gap-1.5\">\n                        <span\n                          className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${\n                            item.type === \'lost\'\n                              ? \'bg-[#EFF6FF] text-[#2563EB]\'\n                              : \'bg-[#ECFDF5] text-[#059669]\'\n                          }`}\n                        >\n                          {item.type}\n                        </span>\n                        <span className=\"px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-500 text-[10px] font-bold uppercase tracking-wider\">\n                          {item.status}\n                        </span>\n                      </div>\n                      <button\n                        onClick={() => onEditItem(item)}\n                        className=\"text-xs font-semibold text-[#C2410C] hover:text-[#9A3412] cursor-pointer\"\n                      >\n                        Edit\n                      </button>\n                    </div>\n\n                    {/* Content Section */}\n                    <div className=\"space-y-3\">\n                      <h3 className=\"font-extrabold text-gray-900 text-lg tracking-tight leading-snug\">\n                        {item.title}\n                      </h3>\n                      \n                      <div className=\"space-y-1.5 text-xs text-gray-500 font-medium\">\n                        <div className=\"flex items-center gap-2\">\n                          <MapPin className=\"w-3.5 h-3.5 text-gray-400 shrink-0\" />\n                          <span>{item.location}</span>\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Calendar className=\"w-3.5 h-3.5 text-gray-400 shrink-0\" />\n                          <span>{item.date}</span>\n                        </div>\n                      </div>\n\n                      <p className=\"text-xs text-gray-600 leading-relaxed pt-2 border-t border-gray-50\">\n                        {item.description}\n                      </p>\n                    </div>\n\n                    {/* Image Attachment Indicator (if exists) */}\n                    {item.image && (\n                      <div className=\"mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-400\">\n                        <span>Photo attached</span>\n                        <span className=\"w-1.5 h-1.5 rounded-full bg-green-500\" />\n                      </div>\n                    )}\n                  </div>\n                ))}\n              </div>\n            )\n          ) : (\n            /* MATCHES TAB */\n            myMatches.length === 0 ? (\n              <div className=\"flex flex-col items-center justify-center py-16 text-center space-y-4\">\n                <Sparkles className=\"w-12 h-12 text-blue-200\" />\n                <div>\n                  <h3 className=\"font-bold text-gray-800\">No matches found yet</h3>\n                  <p className=\"text-sm text-gray-400 mt-1 max-w-xs\">Our matching engine runs automatically. We will notify you once potential matches are found.</p>\n                </div>\n              </div>\n            ) : (\n              <div className=\"space-y-6\">\n                {myMatches.map((match) => {\n                  const userItem = items.find(i => i.id === match.userItemId);\n                  \n                  return (\n                    <div\n                      key={match.id}\n                      className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col xl:flex-row xl:items-center justify-between gap-6\"\n                    >\n                      {/* Left: Your Item */}\n                      <div className=\"flex-1 bg-gray-50/50 rounded-lg p-4 border border-gray-50\">\n                        <span className=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1\">\n                          Your Item\n                        </span>\n                        <h4 className=\"font-extrabold text-gray-900 text-base\">\n                          {userItem?.title || \'Unknown Item\'}\n                        </h4>\n                        <div className=\"flex items-center gap-1.5 mt-1 text-xs text-gray-500\">\n                          <MapPin className=\"w-3.5 h-3.5 text-gray-400\" />\n                          <span>{userItem?.location}</span>\n                        </div>\n                      </div>\n\n                      {/* Center: Match Percentage */}\n                      <div className=\"flex flex-col items-center justify-center shrink-0 py-2\">\n                        <span className=\"px-3 py-1 text-xs font-bold text-[#2563EB] bg-[#EFF6FF] rounded-full border border-blue-100\">\n                          {match.matchPercentage}% Match\n                        </span>\n                        {/* Connecting Line */}\n                        <div className=\"w-16 h-0.5 bg-gray-100 mt-2.5 hidden xl:block\" />\n                      </div>\n\n                      {/* Right: Matched Item */}\n                      <div className=\"flex-1 bg-gray-50/50 rounded-lg p-4 border border-gray-50\">\n                        <span className=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1\">\n                          Matched Item\n                        </span>\n                        <h4 className=\"font-extrabold text-gray-900 text-base\">\n                          {match.matchedItemTitle}\n                        </h4>\n                        <div className=\"flex items-center gap-1.5 mt-1 text-xs text-gray-500\">\n                          <MapPin className=\"w-3.5 h-3.5 text-gray-400\" />\n                          <span>{match.matchedItemLocation}</span>\n                        </div>\n                      </div>\n\n                      {/* Action States */}\n                      <div className=\"shrink-0 flex flex-col sm:flex-row xl:flex-col gap-2.5 min-w-[160px] justify-center\">\n                        {match.status === \'pending\' && (\n                          <>\n                            <button\n                              onClick={() => onOpenChat(match.chatId)}\n                              className=\"px-4 py-2 bg-[#2563EB] hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition-colors cursor-pointer flex items-center justify-center gap-1.5 shadow-sm\"\n                            >\n                              <MessageSquare className=\"w-3.5 h-3.5\" />\n                              Message Finder\n                            </button>\n                            <button\n                              onClick={() => onUpdateMatchStatus(match.id, \'rejected\')}\n                              className=\"px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 text-xs font-semibold rounded-lg transition-colors cursor-pointer\"\n                            >\n                              Not a Match\n                            </button>\n                          </>\n                        )}\n\n                        {match.status === \'confirmed\' && (\n                          <div className=\"flex flex-col gap-2 w-full\">\n                            <span className=\"px-3 py-2 bg-green-50 border border-green-200 text-green-700 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5\">\n                              <CheckCircle2 className=\"w-4 h-4\" />\n                              Match Confirmed\n                            </span>\n                            <button\n                              onClick={() => onOpenChat(match.chatId)}\n                              className=\"px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold rounded-lg transition-colors cursor-pointer\"\n                            >\n                              View Chat\n                            </button>\n                          </div>\n                        )}\n\n                        {match.status === \'rejected\' && (\n                          <span className=\"px-3 py-2 bg-gray-50 border border-gray-200 text-gray-500 rounded-lg text-xs font-bold flex items-center justify-center gap-1.5\">\n                            <XCircle className=\"w-4 h-4 text-gray-400\" />\n                            Match Rejected\n                          </span>\n                        )}\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            )\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
