    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Cpu, ArrowRight, Heart, MapPin, Users } from \'lucide-react\';\n\nexport default function About() {\n  return (\n    <div className=\"max-w-4xl mx-auto px-6 py-12 space-y-12 font-sans bg-white\">\n      {/* Hero Header */}\n      <div className=\"text-center space-y-4\">\n        <h1 className=\"text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl\">\n          About Campus <span className=\"text-[#2563EB]\">Lost & Found</span>\n        </h1>\n        <p className=\"text-lg text-gray-500 max-w-xl mx-auto leading-relaxed\">\n          Reuniting the campus community, one item at a time. Empowering students with automated similarity matching.\n        </p>\n      </div>\n\n      {/* Grid Features */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 pt-6\">\n        <div className=\"bg-[#FAFAFA] border border-gray-100 rounded-2xl p-6 text-center space-y-3\">\n          <div className=\"w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mx-auto border border-blue-100\">\n            <Cpu className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"font-bold text-gray-900 text-lg\">Smart Matching</h3>\n          <p className=\"text-sm text-gray-500 leading-relaxed\">\n            Our automated matching engine cross-references descriptions, locations, and times to find potential matches instantly.\n          </p>\n        </div>\n\n        <div className=\"bg-[#FAFAFA] border border-gray-100 rounded-2xl p-6 text-center space-y-3\">\n          <div className=\"w-12 h-12 bg-green-50 text-green-600 rounded-xl flex items-center justify-center mx-auto border border-green-100\">\n            <ShieldCheck className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"font-bold text-gray-900 text-lg\">Secure Chat</h3>\n          <p className=\"text-sm text-gray-500 leading-relaxed\">\n            Chat securely with finders or owners without exposing personal phone numbers or social profiles until you trust them.\n          </p>\n        </div>\n\n        <div className=\"bg-[#FAFAFA] border border-gray-100 rounded-2xl p-6 text-center space-y-3\">\n          <div className=\"w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center mx-auto border border-purple-100\">\n            <Users className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"font-bold text-gray-900 text-lg\">By the Students</h3>\n          <p className=\"text-sm text-gray-500 leading-relaxed\">\n            Designed to foster trust, cooperation, and support on campus, making it easier for students to help one another.\n          </p>\n        </div>\n      </div>\n\n      {/* Safe Exchange Zones section */}\n      <div className=\"bg-blue-50/50 rounded-2xl p-8 border border-blue-100 space-y-6\">\n        <h3 className=\"text-xl font-bold text-blue-950 flex items-center gap-2\">\n          <MapPin className=\"w-5 h-5 text-blue-600\" />\n          Recommended Safe Exchange Zones\n        </h3>\n        <p className=\"text-sm text-gray-600 leading-relaxed\">\n          For your safety and peace of mind, we strongly recommend coordinating physical items handover in well-lit, heavily populated public locations on campus. Always inform a friend of your plans!\n        </p>\n        \n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm font-medium text-gray-800\">\n          <div className=\"bg-white rounded-xl p-4 border border-gray-100 flex items-center gap-3\">\n            <span className=\"w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0\">1</span>\n            <span>University Library Main Foyer</span>\n          </div>\n          <div className=\"bg-white rounded-xl p-4 border border-gray-100 flex items-center gap-3\">\n            <span className=\"w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0\">2</span>\n            <span>Senate Building Front steps</span>\n          </div>\n          <div className=\"bg-white rounded-xl p-4 border border-gray-100 flex items-center gap-3\">\n            <span className=\"w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0\">3</span>\n            <span>Student Union Building (SUB) plaza</span>\n          </div>\n          <div className=\"bg-white rounded-xl p-4 border border-gray-100 flex items-center gap-3\">\n            <span className=\"w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0\">4</span>\n            <span>Science Lecture Theatre quad</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Mission Footer */}\n      <div className=\"border-t border-gray-100 pt-8 text-center text-xs text-gray-400 font-medium flex items-center justify-center gap-1\">\n        <span>Made with</span>\n        <Heart className=\"w-3.5 h-3.5 text-red-500 fill-red-500\" />\n        <span>for the Campus Community \302\251 2026</span>\n      </div>\n    </div>\n  );\n}\n"
    }
