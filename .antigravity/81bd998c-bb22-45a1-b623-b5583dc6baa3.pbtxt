      replacement_content: "import React, { useState } from \'react\';\nimport { Bell, MessageSquare, LogOut, User, Layers } from \'lucide-react\';\nimport { User as UserType } from \'../types\';\n\ninterface HeaderProps {\n  currentUser: UserType | null;\n  currentTab: string;\n  onTabChange: (tab: string) => void;\n  onLogout: () => void;\n  unreadMessagesCount: number;\n}\n\nexport default function Header({\n  currentUser,\n  currentTab,\n  onTabChange,\n  onLogout,\n  unreadMessagesCount\n}: HeaderProps) {\n  const [showProfileMenu, setShowProfileMenu] = useState(false);\n  const [showNotifications, setShowNotifications] = useState(false);\n\n  // Mock Notification\n  const notifications = [\n    {\n      id: \'1\',\n      title: \'New Match Found!\',\n      desc: \'An 85% match was found for your HP Laptop Charger.\',\n      time: \'Just now\',\n      unread: true,\n      action: \'dashboard-matches\'\n    }\n  ];\n\n  const handleNotificationClick = (action: string) => {\n    setShowNotifications(false);\n    if (action === \'dashboard-matches\') {\n      onTabChange(\'dashboard\');\n      // Set active tab inside dashboard to matches\n      setTimeout(() => {\n        const matchesTabBtn = document.getElementById(\'tab-matches-trigger\');\n        if (matchesTabBtn) matchesTabBtn.click();\n      }, 50);\n    }\n  };\n\n  return (\n    <header className=\"sticky top-0 z-50 bg-white border-b border-gray-100 px-6 py-4\">\n      <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n        {/* Left: Logo */}\n        <div \n          onClick={() => onTabChange(\'landing\')}\n          className=\"flex items-center gap-3 cursor-pointer select-none group\"\n        >\n          <div className=\"w-9 h-9 rounded-full bg-gray-200 transition-colors group-hover:bg-gray-300\" />\n          <span className=\"font-serif text-2xl font-extrabold tracking-wide text-black\">CLF</span>\n        </div>\n\n        {/* Center: Navigation Links */}\n        <nav className=\"hidden md:flex items-center gap-8\">\n          <button\n            onClick={() => onTabChange(\'dashboard\')}\n            className={`font-sans text-sm font-medium transition-colors cursor-pointer ${\n              currentTab === \'dashboard\'\n                ? \'text-black font-semibold\'\n                : \'text-gray-500 hover:text-black\'\n            }`}\n          >\n            Dashboard\n          </button>\n          \n          <button\n            onClick={() => {\n              if (currentUser) {\n                onTabChange(\'report-lost\');\n              } else {\n                onTabChange(\'signin\');\n              }\n            }}\n            className={`font-sans text-sm font-medium transition-colors cursor-pointer ${\n              currentTab === \'report-lost\' || currentTab === \'report-found\'\n                ? \'text-black font-semibold\'\n                : \'text-gray-500 hover:text-black\'\n            }`}\n          >\n            Report item\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'find-item\')}\n            className={`font-sans text-sm font-medium transition-colors cursor-pointer ${\n              currentTab === \'find-item\'\n                ? \'text-black font-semibold\'\n                : \'text-gray-500 hover:text-black\'\n            }`}\n          >\n            Find item\n          </button>\n\n          <button\n            onClick={() => onTabChange(\'about\')}\n            className={`font-sans text-sm font-medium transition-colors cursor-pointer ${\n              currentTab === \'about\'\n                ? \'text-black font-semibold\'\n                : \'text-gray-500 hover:text-black\'\n            }`}\n          >\n            About\n          </button>\n        </nav>\n\n        {/* Right: Actions */}\n        <div className=\"flex items-center gap-5\">\n          {currentUser ? (\n            <>\n              {/* Notification Bell */}\n              <div className=\"relative\">\n                <button\n                  onClick={() => {\n                    setShowNotifications(!showNotifications);\n                    setShowProfileMenu(false);\n                  }}\n                  className=\"relative p-2 text-gray-700 hover:bg-gray-100 rounded-full transition-colors cursor-pointer\"\n                  id=\"header-notification-bell\"\n                >\n                  <Bell className=\"w-[22px] h-[22px]\" />\n                  {notifications.some(n => n.unread) && (\n                    <span className=\"absolute top-1 right-1 w-4 h-4 bg-red-500 text-[10px] font-bold text-white rounded-full flex items-center justify-center border-2 border-white\">\n                      1\n                    </span>\n                  )}\n                </button>\n\n                {/* Notifications Dropdown */}\n                {showNotifications && (\n                  <div className=\"absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-lg border border-gray-100 py-2 z-50 animate-fade-in\">\n                    <div className=\"px-4 py-2 border-b border-gray-50 font-semibold text-sm text-gray-800\">\n                      Notifications\n                    </div>\n                    {notifications.map((notif) => (\n                      <div\n                        key={notif.id}\n                        onClick={() => handleNotificationClick(notif.action)}\n                        className=\"px-4 py-3 hover:bg-gray-50 cursor-pointer transition-colors\"\n                      >\n                        <div className=\"flex justify-between items-start mb-1\">\n                          <span className=\"font-medium text-xs text-blue-600\">Match Alert</span>\n                          <span className=\"text-[10px] text-gray-400\">{notif.time}</span>\n                        </div>\n                        <p className=\"text-sm font-semibold text-gray-800\">{notif.title}</p>\n                        <p className=\"text-xs text-gray-500 mt-0.5 leading-relaxed\">{notif.desc}</p>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Chat Icon */}\n              <button\n                onClick={() => onTabChange(\'messages\')}\n                className=\"relative p-2 text-gray-700 hover:bg-gray-100 rounded-full transition-colors cursor-pointer\"\n              >\n                <MessageSquare className=\"w-[22px] h-[22px]\" />\n                {unreadMessagesCount > 0 && (\n                  <span className=\"absolute top-1 right-1 w-4 h-4 bg-blue-600 text-[10px] font-bold text-white rounded-full flex items-center justify-center border-2 border-white\">\n                    {unreadMessagesCount}\n                  </span>\n                )}\n              </button>\n\n              {/* User Avatar Circle */}\n              <div className=\"relative\">\n                <button\n                  onClick={() => {\n                    setShowProfileMenu(!showProfileMenu);\n                    setShowNotifications(false);\n                  }}\n                  className=\"w-10 h-10 rounded-full bg-gray-200 hover:bg-gray-300 transition-colors cursor-pointer flex items-center justify-center font-bold text-gray-600 border border-gray-100 shadow-sm\"\n                >\n                  {currentUser.avatar ? (\n                    <img \n                      src={currentUser.avatar} \n                      alt={currentUser.name} \n                      className=\"w-full h-full rounded-full object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  ) : (\n                    currentUser.name.split(\' \').map(n => n[0]).join(\'\').toUpperCase()\n                  )}\n                </button>\n\n                {/* Profile Dropdown */}\n                {showProfileMenu && (\n                  <div className=\"absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-gray-100 py-2 z-50\">\n                    <div className=\"px-4 py-2 border-b border-gray-100\">\n                      <p className=\"font-semibold text-sm text-gray-800\">{currentUser.name}</p>\n                      <p className=\"text-xs text-gray-400 truncate\">{currentUser.email}</p>\n                      <p className=\"text-[10px] text-gray-500 font-mono mt-0.5\">Matric: {currentUser.matricNumber}</p>\n                    </div>\n                    \n                    <button\n                      onClick={() => {\n                        setShowProfileMenu(false);\n                        onTabChange(\'dashboard\');\n                      }}\n                      className=\"w-full px-4 py-2.5 text-left text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2\"\n                    >\n                      <Layers className=\"w-4 h-4\" />\n                      My Dashboard\n                    </button>\n\n                    <button\n                      onClick={() => {\n                        setShowProfileMenu(false);\n                        onLogout();\n                      }}\n                      className=\"w-full px-4 py-2.5 text-left text-sm text-red-600 hover:bg-red-50 flex items-center gap-2 border-t border-gray-50\"\n                    >\n                      <LogOut className=\"w-4 h-4\" />\n                      Sign Out\n                    </button>\n                  </div>\n                )}\n              </div>\n            </>\n          ) : (\n            <div className=\"flex items-center gap-3\">\n              <button\n                onClick={() => onTabChange(\'signin\')}\n                className=\"px-4 py-2 text-sm font-medium text-gray-700 hover:text-black hover:bg-gray-50 rounded-lg transition-colors cursor-pointer\"\n              >\n                Sign In\n              </button>\n              <button\n                onClick={() => onTabChange(\'signup\')}\n                className=\"px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm cursor-pointer\"\n              >\n                Sign Up\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n}\n"
    }
