    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowRight, Check, ShieldAlert, Award, Sparkles, MapPin, Search } from \'lucide-react\';\n\ninterface LandingPageProps {\n  onStartReporting: (type: \'lost\' | \'found\') => void;\n  onNavigateToFind: () => void;\n  stats: {\n    lost: number;\n    found: number;\n    matches: number;\n    matchesThisWeek: number;\n  };\n}\n\nexport default function LandingPage({ onStartReporting, onNavigateToFind, stats }: LandingPageProps) {\n  return (\n    <div className=\"bg-white min-h-screen\">\n      {/* Hero Section */}\n      <section className=\"max-w-7xl mx-auto px-6 pt-16 pb-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        <div className=\"lg:col-span-7 space-y-8\">\n          <h1 className=\"text-4xl md:text-5xl lg:text-[54px] font-extrabold tracking-tight text-gray-900 leading-[1.15]\">\n            Welcome to Campus <span className=\"text-[#2563EB]\">Lost & Found</span>\n          </h1>\n          \n          <p className=\"text-lg text-gray-600 max-w-xl leading-relaxed\">\n            Helping students reunite with their belongings, with our automated item-matching algorithm. Report lost or found items and connect with fellow students.\n          </p>\n\n          <div className=\"flex flex-wrap gap-4 pt-2\">\n            <button\n              onClick={() => onStartReporting(\'lost\')}\n              className=\"px-8 py-4 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-all shadow-md shadow-blue-100 hover:shadow-lg hover:-translate-y-0.5 cursor-pointer flex items-center gap-2\"\n            >\n              I Lost Something\n              <ArrowRight className=\"w-5 h-5\" />\n            </button>\n            <button\n              onClick={() => onStartReporting(\'found\')}\n              className=\"px-8 py-4 text-base font-semibold text-gray-700 bg-white hover:bg-gray-50 border border-gray-300 rounded-xl transition-all hover:shadow-md hover:-translate-y-0.5 cursor-pointer\"\n            >\n              I Found Something\n            </button>\n          </div>\n        </div>\n\n        {/* Hero Interactive Illustration / Mockup */}\n        <div className=\"lg:col-span-5\">\n          <div className=\"relative w-full aspect-[4/3] bg-gray-100 rounded-2xl overflow-hidden p-6 border border-gray-200 shadow-sm flex flex-col justify-between\">\n            {/* Minimal Mockup Elements to represent matching */}\n            <div className=\"flex justify-between items-center pb-4 border-b border-gray-200\">\n              <span className=\"text-xs font-mono text-gray-400\">matching_algorithm_v2.4</span>\n              <span className=\"px-2 py-0.5 text-[10px] font-semibold text-blue-600 bg-blue-50 rounded-full flex items-center gap-1 animate-pulse\">\n                <Sparkles className=\"w-2.5 h-2.5\" />\n                Live Matching\n              </span>\n            </div>\n\n            <div className=\"space-y-4 my-auto relative\">\n              {/* Lost card mockup */}\n              <div className=\"bg-white rounded-xl p-4 border border-blue-100 shadow-sm transform -rotate-2 relative z-10 hover:rotate-0 transition-all\">\n                <div className=\"flex justify-between items-start mb-2\">\n                  <span className=\"px-2 py-0.5 text-[9px] font-bold text-blue-600 bg-blue-50 rounded-full uppercase\">Lost</span>\n                  <span className=\"text-[10px] text-gray-400 font-mono\">10:42 AM</span>\n                </div>\n                <h4 className=\"font-bold text-sm text-gray-800\">HP Laptop Charger</h4>\n                <p className=\"text-xs text-gray-400 flex items-center gap-1 mt-1\">\n                  <MapPin className=\"w-3 h-3 text-gray-400\" /> Library 2nd Floor\n                </p>\n              </div>\n\n              {/* Connector */}\n              <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex flex-col items-center\">\n                <div className=\"bg-blue-600 text-white rounded-full p-2 shadow-lg border-2 border-white text-xs font-extrabold px-3\">\n                  85% Match\n                </div>\n              </div>\n\n              {/* Found card mockup */}\n              <div className=\"bg-white rounded-xl p-4 border border-green-100 shadow-sm transform rotate-2 relative z-10 ml-auto w-[85%] hover:rotate-0 transition-all\">\n                <div className=\"flex justify-between items-start mb-2\">\n                  <span className=\"px-2 py-0.5 text-[9px] font-bold text-green-600 bg-green-50 rounded-full uppercase\">Found</span>\n                  <span className=\"text-[10px] text-gray-400 font-mono\">Just Now</span>\n                </div>\n                <h4 className=\"font-bold text-sm text-gray-800\">Laptop Power Adapter</h4>\n                <p className=\"text-xs text-gray-400 flex items-center gap-1 mt-1\">\n                  <MapPin className=\"w-3 h-3 text-gray-400\" /> Library near Coffee Stand\n                </p>\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-gray-200 flex justify-between items-center text-xs\">\n              <span className=\"text-gray-500 font-medium\">Reuniting students everyday</span>\n              <button \n                onClick={onNavigateToFind}\n                className=\"text-blue-600 hover:text-blue-700 font-semibold flex items-center gap-1\"\n              >\n                Browse Items <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Stats Section */}\n      <section className=\"max-w-7xl mx-auto px-6 py-8\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {/* Card 1 */}\n          <div className=\"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"w-14 h-14 rounded-2xl bg-orange-50 flex items-center justify-center text-orange-600 font-bold text-3xl mb-4\">\n              {stats.lost}\n            </div>\n            <p className=\"text-base font-semibold text-gray-800\">Items Lost</p>\n            <p className=\"text-xs text-gray-400 mt-1\">Awaiting to be reunited</p>\n          </div>\n\n          {/* Card 2 */}\n          <div className=\"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"w-14 h-14 rounded-2xl bg-green-50 flex items-center justify-center text-green-600 font-bold text-3xl mb-4\">\n              {stats.found}\n            </div>\n            <p className=\"text-base font-semibold text-gray-800\">Items Found</p>\n            <p className=\"text-xs text-gray-400 mt-1\">Safely logged on campus</p>\n          </div>\n\n          {/* Card 3 */}\n          <div className=\"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600 font-bold text-3xl mb-4\">\n              {stats.matches}\n            </div>\n            <p className=\"text-base font-semibold text-gray-800\">Matches Made</p>\n            <p className=\"text-xs text-gray-400 mt-1\">Reunited successfully</p>\n          </div>\n\n          {/* Card 4 */}\n          <div className=\"bg-white border border-gray-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"w-14 h-14 rounded-2xl bg-purple-50 flex items-center justify-center text-purple-600 font-bold text-3xl mb-4\">\n              {stats.matchesThisWeek}\n            </div>\n            <p className=\"text-base font-semibold text-gray-800\">Matches Made This Week</p>\n            <p className=\"text-xs text-gray-400 mt-1\">Active matching this week</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Tips Section */}\n      <section className=\"max-w-7xl mx-auto px-6 py-12\">\n        <div className=\"bg-[#EFF6FF] border border-[#BFDBFE] rounded-2xl p-8\">\n          <h3 className=\"text-lg font-bold text-[#1E3A8A] mb-5 flex items-center gap-2\">\n            <ShieldAlert className=\"w-5 h-5 text-blue-600\" />\n            Tips for Success\n          </h3>\n          <ul className=\"space-y-4\">\n            <li className=\"flex items-start gap-3\">\n              <span className=\"w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 mt-0.5 shrink-0\">\n                <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n              </span>\n              <p className=\"text-sm text-gray-700 leading-normal\">\n                Provide detailed descriptions including colors, brands, and unique features.\n              </p>\n            </li>\n            <li className=\"flex items-start gap-3\">\n              <span className=\"w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 mt-0.5 shrink-0\">\n                <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n              </span>\n              <p className=\"text-sm text-gray-700 leading-normal\">\n                Include the exact location and time you found or lost the item.\n              </p>\n            </li>\n            <li className=\"flex items-start gap-3\">\n              <span className=\"w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 mt-0.5 shrink-0\">\n                <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n              </span>\n              <p className=\"text-sm text-gray-700 leading-normal\">\n                Check back regularly for matches and respond to messages promptly.\n              </p>\n            </li>\n          </ul>\n        </div>\n      </section>\n    </div>\n  );\n}\n"
    }
