    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Eye, EyeOff, Lock, User, Mail, Sparkles } from \'lucide-react\';\nimport { User as UserType } from \'../types\';\n\ninterface AuthProps {\n  initialScreen: \'signin\' | \'signup\';\n  onAuthSuccess: (user: UserType) => void;\n  onSwitchScreen: (screen: \'signin\' | \'signup\') => void;\n}\n\nexport default function Auth({ initialScreen, onAuthSuccess, onSwitchScreen }: AuthProps) {\n  const [screen, setScreen] = useState<\'signin\' | \'signup\'>(initialScreen);\n  const [fullname, setFullname] = useState(\'\');\n  const [matricNumber, setMatricNumber] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\n  const [showPassword, setShowPassword] = useState(false);\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    \n    if (screen === \'signup\') {\n      if (!fullname || !matricNumber || !email || !password || !confirmPassword) {\n        alert(\'Please fill in all fields.\');\n        return;\n      }\n      if (password !== confirmPassword) {\n        alert(\'Passwords do not match.\');\n        return;\n      }\n      // Trigger signup success\n      const newUser: UserType = {\n        id: \'user-\' + Date.now(),\n        name: fullname,\n        matricNumber: matricNumber.toUpperCase(),\n        email: email,\n        avatar: undefined\n      };\n      onAuthSuccess(newUser);\n    } else {\n      if (!matricNumber || !password) {\n        alert(\'Please fill in both Matric number and password.\');\n        return;\n      }\n      // Mock login as Mr Alex or whoever they type\n      const loggedUser: UserType = {\n        id: \'user-alex\',\n        name: matricNumber.toLowerCase() === \'oau/2022/0123\' || matricNumber.toLowerCase() === \'alex\' ? \'Mr Alex\' : matricNumber,\n        matricNumber: matricNumber.toUpperCase(),\n        email: matricNumber.toLowerCase() === \'alex\' ? \'alex@students.oauife.edu.ng\' : `${matricNumber.toLowerCase().replace(/\\//g, \'\')}@students.oauife.edu.ng`,\n        avatar: undefined\n      };\n      onAuthSuccess(loggedUser);\n    }\n  };\n\n  const handleGoogleMock = () => {\n    const googleUser: UserType = {\n      id: \'user-google\',\n      name: \'Google Student\',\n      matricNumber: \'OAU/2023/8899\',\n      email: \'google.student@students.oauife.edu.ng\',\n    };\n    onAuthSuccess(googleUser);\n  };\n\n  const handleAppleMock = () => {\n    const appleUser: UserType = {\n      id: \'user-apple\',\n      name: \'Apple Student\',\n      matricNumber: \'OAU/2023/1122\',\n      email: \'apple.student@students.oauife.edu.ng\',\n    };\n    onAuthSuccess(appleUser);\n  };\n\n  return (\n    <div className=\"bg-white min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-sans\">\n      <div className=\"sm:mx-auto sm:w-full sm:max-w-md space-y-2 text-center px-4\">\n        <h2 className=\"text-3xl font-extrabold text-black tracking-tight\">\n          {screen === \'signin\' ? \'Sign in to your account\' : \'Create an account\'}\n        </h2>\n        <p className=\"text-sm text-gray-500\">\n          {screen === \'signin\' ? \'Enter your email below to sign in\' : \'Enter your email below to create an account\'}\n        </p>\n      </div>\n\n      <div className=\"mt-8 sm:mx-auto sm:w-full sm:max-w-md px-4\">\n        <div className=\"bg-white py-8 px-4 border border-gray-100 rounded-2xl sm:px-10\">\n          <form className=\"space-y-5\" onSubmit={handleSubmit}>\n            \n            {/* SIGN UP: Name field */}\n            {screen === \'signup\' && (\n              <div className=\"space-y-1.5\">\n                <label className=\"block text-sm font-semibold text-gray-700\">\n                  Name\n                </label>\n                <div className=\"relative rounded-xl shadow-sm\">\n                  <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400\">\n                    <User className=\"h-[18px] w-[18px]\" />\n                  </div>\n                  <input\n                    type=\"text\"\n                    required\n                    value={fullname}\n                    onChange={(e) => setFullname(e.target.value)}\n                    placeholder=\"enter fullname\"\n                    className=\"block w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors\"\n                  />\n                </div>\n              </div>\n            )}\n\n            {/* Matric Number field */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-sm font-semibold text-gray-700\">\n                Matric number\n              </label>\n              <div className=\"relative rounded-xl shadow-sm\">\n                <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 font-mono text-xs font-bold select-none\">\n                  123\n                </div>\n                <input\n                  type=\"text\"\n                  required\n                  value={matricNumber}\n                  onChange={(e) => setMatricNumber(e.target.value)}\n                  placeholder=\"enter matric number\"\n                  className=\"block w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors uppercase font-medium\"\n                />\n              </div>\n            </div>\n\n            {/* SIGN UP: School email address */}\n            {screen === \'signup\' && (\n              <div className=\"space-y-1.5\">\n                <label className=\"block text-sm font-semibold text-gray-700\">\n                  School email address\n                </label>\n                <div className=\"relative rounded-xl shadow-sm\">\n                  <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400\">\n                    <Mail className=\"h-[18px] w-[18px]\" />\n                  </div>\n                  <input\n                    type=\"email\"\n                    required\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"name@students.oauife.edu.ng\"\n                    className=\"block w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors text-gray-700 font-medium\"\n                  />\n                </div>\n              </div>\n            )}\n\n            {/* Password field */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-sm font-semibold text-gray-700\">\n                Password\n              </label>\n              <div className=\"relative rounded-xl shadow-sm\">\n                <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400\">\n                  <Lock className=\"h-[18px] w-[18px]\" />\n                </div>\n                <input\n                  type={showPassword ? \'text\' : \'password\'}\n                  required\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  placeholder=\"create a password\"\n                  className=\"block w-full pl-10 pr-10 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors\"\n                />\n                <button\n                  type=\"button\"\n                  onClick={() => setShowPassword(!showPassword)}\n                  className=\"absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer\"\n                >\n                  {showPassword ? <EyeOff className=\"h-4 w-4\" /> : <Eye className=\"h-4 w-4\" />}\n                </button>\n              </div>\n            </div>\n\n            {/* SIGN UP: Confirm Password */}\n            {screen === \'signup\' && (\n              <div className=\"space-y-1.5\">\n                <label className=\"block text-sm font-semibold text-gray-700\">\n                  Confirm password\n                </label>\n                <div className=\"relative rounded-xl shadow-sm\">\n                  <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400\">\n                    <Lock className=\"h-[18px] w-[18px]\" />\n                  </div>\n                  <input\n                    type={showConfirmPassword ? \'text\' : \'password\'}\n                    required\n                    value={confirmPassword}\n                    onChange={(e) => setConfirmPassword(e.target.value)}\n                    placeholder=\"create a password\"\n                    className=\"block w-full pl-10 pr-10 py-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowConfirmPassword(!showConfirmPassword)}\n                    className=\"absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer\"\n                  >\n                    {showConfirmPassword ? <EyeOff className=\"h-4 w-4\" /> : <Eye className=\"h-4 w-4\" />}\n                  </button>\n                </div>\n              </div>\n            )}\n\n            {/* Divider Or */}\n            <div className=\"relative py-2\">\n              <div className=\"absolute inset-0 flex items-center\" aria-hidden=\"true\">\n                <div className=\"w-full border-t border-gray-200\" />\n              </div>\n              <div className=\"relative flex justify-center text-xs uppercase\">\n                <span className=\"px-2.5 bg-white text-gray-400 font-medium\">Or</span>\n              </div>\n            </div>\n\n            {/* OAuth Buttons */}\n            <div className=\"grid grid-cols-1 gap-3\">\n              <button\n                type=\"button\"\n                onClick={handleGoogleMock}\n                className=\"w-full inline-flex justify-center items-center py-3 px-4 border border-gray-200 rounded-xl shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer gap-2\"\n              >\n                {/* Custom Google SVG Icon */}\n                <svg className=\"w-4 h-4\" viewBox=\"0 0 24 24\">\n                  <path\n                    fill=\"#EA4335\"\n                    d=\"M12 5.04c1.78 0 3.3.61 4.56 1.81l3.41-3.41C17.92 1.44 15.17.48 12 .48 7.31.48 3.28 3.17 1.34 7.09l4.13 3.2C6.44 7.37 9.02 5.04 12 5.04z\"\n                  />\n                  <path\n                    fill=\"#4285F4\"\n                    d=\"M23.52 12.27c0-.84-.08-1.65-.22-2.43H12v4.61h6.47c-.28 1.48-1.12 2.73-2.38 3.58l3.69 2.87c2.16-1.99 3.74-4.92 3.74-8.63z\"\n                  />\n                  <path\n                    fill=\"#FBBC05\"\n                    d=\"M5.47 14.11a7.06 7.06 0 0 1 0-4.22L1.34 6.69a11.962 11.962 0 0 0 0 10.62l4.13-3.2z\"\n                  />\n                  <path\n                    fill=\"#34A853\"\n                    d=\"M12 23.52c3.24 0 5.95-1.08 7.93-2.91l-3.69-2.87c-1.02.68-2.33 1.09-4.24 1.09-2.98 0-5.56-2.33-6.53-5.25l-4.13 3.2a11.96 11.96 0 0 0 10.66 6.74z\"\n                  />\n                </svg>\n                Continue with Google\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleAppleMock}\n                className=\"w-full inline-flex justify-center items-center py-3 px-4 border border-gray-200 rounded-xl shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors cursor-pointer gap-2\"\n              >\n                {/* Custom Apple SVG Icon */}\n                <svg className=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                  <path d=\"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.17c.66-.81 1.11-1.93.99-3.06-.96.04-2.13.64-2.82 1.45-.6.69-1.12 1.84-.98 2.94.1.08 2.15.08 2.81-.83\" />\n                </svg>\n                Continue with Apple\n              </button>\n            </div>\n\n            {/* Main Submit Button */}\n            <div>\n              <button\n                type=\"submit\"\n                className=\"w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all cursor-pointer shadow-blue-50\"\n              >\n                {screen === \'signin\' ? \'Sign in\' : \'Create account\'}\n              </button>\n            </div>\n\n          </form>\n\n          {/* Screen Switch Trigger Footer */}\n          <div className=\"mt-6 text-center\">\n            <span className=\"text-sm text-gray-500 font-medium\">\n              {screen === \'signin\' ? \"Don\'t have an account? \" : \'Already have an account? \'}\n            </span>\n            <button\n              onClick={() => {\n                const next = screen === \'signin\' ? \'signup\' : \'signin\';\n                setScreen(next);\n                onSwitchScreen(next);\n              }}\n              className=\"text-sm font-semibold text-blue-600 hover:text-blue-700 cursor-pointer\"\n            >\n              {screen === \'signin\' ? \'Sign up\' : \'Sign in\'}\n            </button>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  );\n}\n"
