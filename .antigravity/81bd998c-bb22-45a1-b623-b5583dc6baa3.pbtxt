    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport Header from \'./components/Header\';\nimport LandingPage from \'./components/LandingPage\';\nimport Dashboard from \'./components/Dashboard\';\nimport Messages from \'./components/Messages\';\nimport ReportForm from \'./components/ReportForm\';\nimport Auth from \'./components/Auth\';\nimport About from \'./components/About\';\nimport FindItem from \'./components/FindItem\';\nimport { LoggedItem, Match, Conversation, User, Message } from \'./types\';\n\n// Initial Mock User\nconst defaultUser: User = {\n  id: \'user-alex\',\n  name: \'Mr Alex\',\n  matricNumber: \'OAU/2022/0123\',\n  email: \'alex@students.oauife.edu.ng\'\n};\n\n// Initial Mock Items\nconst initialItems: LoggedItem[] = [\n  {\n    id: \'item-1\',\n    title: \'HP Laptop Charger\',\n    type: \'lost\',\n    status: \'active\',\n    category: \'Electronics\',\n    description: \"It is 220W and there\'s a sticker on the adapter.\",\n    location: \'Library 2nd Floor\',\n    date: \'2026-04-15\',\n    userId: \'user-alex\'\n  },\n  {\n    id: \'item-2\',\n    title: \'Blue Backpack\',\n    type: \'lost\',\n    status: \'active\',\n    category: \'Bags & Wallets\',\n    description: \'Has my gym clothes and a chemistry textbook.\',\n    location: \'Sports Center\',\n    date: \'2026-04-12\',\n    userId: \'user-alex\'\n  },\n  {\n    id: \'item-3\',\n    title: \'Brown Leather Wallet\',\n    type: \'lost\',\n    status: \'active\',\n    category: \'Bags & Wallets\',\n    description: \'Contains my identity card and some cash.\',\n    location: \'Senate Building\',\n    date: \'2026-04-10\',\n    userId: \'user-alex\'\n  },\n  {\n    id: \'item-4\',\n    title: \'Calculus Textbook\',\n    type: \'found\',\n    status: \'active\',\n    category: \'Documents & Books\',\n    description: \'Found on the third row. Name written on page 3 is Stephen.\',\n    location: \'Science Lecture Theatre\',\n    date: \'2026-04-08\',\n    userId: \'user-alex\'\n  },\n  // Items reported by other students\n  {\n    id: \'item-5\',\n    title: \'HP Laptop Charger (Adapter)\',\n    type: \'found\',\n    status: \'active\',\n    category: \'Electronics\',\n    description: \'Found a black HP laptop power adapter 220W on the 2nd floor library table. It has a tiny sticker on it.\',\n    location: \'Library 2nd Floor\',\n    date: \'2026-04-15\',\n    userId: \'user-bh\'\n  },\n  {\n    id: \'item-6\',\n    title: \'Blue hydroflask\',\n    type: \'found\',\n    status: \'active\',\n    category: \'Others\',\n    description: \'Found a blue insulated water bottle with a sticker on the side.\',\n    location: \'Yellow House Pavilion\',\n    date: \'2026-04-18\',\n    userId: \'user-bh\'\n  }\n];\n\n// Initial Mock Matches\nconst initialMatches: Match[] = [\n  {\n    id: \'match-1\',\n    userItemId: \'item-1\', // HP Laptop Charger (Alex)\n    matchedItemId: \'item-5\', // HP Laptop Charger (BH)\n    matchedItemTitle: \'HP Laptop Charger (Adapter)\',\n    matchedItemLocation: \'Library 2nd Floor\',\n    matchedItemType: \'found\',\n    matchPercentage: 85,\n    status: \'pending\',\n    finderName: \'Boluwatife Hassan\',\n    finderAvatar: \'\',\n    chatId: \'chat-1\'\n  }\n];\n\n// Initial Mock Conversations\nconst initialConversations: Conversation[] = [\n  {\n    id: \'chat-1\',\n    title: \'Re: Blue hydroflask\',\n    unreadCount: 2,\n    lastMessageText: \'How about tomorrow at 2pm?\',\n    lastMessageTime: \'10:35 AM\',\n    participants: [\n      {\n        id: \'user-bh\',\n        name: \'Boluwatife Hassan\',\n        avatar: \'\',\n        online: true\n      }\n    ],\n    messages: [\n      {\n        id: \'m-1\',\n        senderId: \'user-bh\',\n        senderName: \'Boluwatife Hassan\',\n        text: \'Hey, what\\\'s up?\',\n        timestamp: \'01:35 PM\'\n      },\n      {\n        id: \'m-2\',\n        senderId: \'me\',\n        senderName: \'Mr Alex\',\n        text: \'Hi\',\n        timestamp: \'01:35 PM\'\n      },\n      {\n        id: \'m-3\',\n        senderId: \'user-bh\',\n        senderName: \'Boluwatife Hassan\',\n        text: \'How about tomorrow at 2pm?\',\n        timestamp: \'01:35 PM\'\n      }\n    ],\n    matchId: \'match-1\'\n  },\n  {\n    id: \'chat-2\',\n    title: \'Re: Brown Leather Wallet\',\n    unreadCount: 1,\n    lastMessageText: \'Yes, that\\\'s my wallet! Thank you so much\',\n    lastMessageTime: \'Yesterday\',\n    participants: [\n      {\n        id: \'user-bl\',\n        name: \'Blessing Lawal\',\n        avatar: \'\',\n        online: false\n      }\n    ],\n    messages: [\n      {\n        id: \'m-4\',\n        senderId: \'user-bl\',\n        senderName: \'Blessing Lawal\',\n        text: \'Yes, that\\\'s my wallet! Thank you so much\',\n        timestamp: \'05:22 PM\'\n      }\n    ]\n  },\n  {\n    id: \'chat-3\',\n    title: \'Re: Blue Backpack\',\n    unreadCount: 0,\n    lastMessageText: \'I can meet at the library\',\n    lastMessageTime: \'2 days ago\',\n    participants: [\n      {\n        id: \'user-bb\',\n        name: \'Bayo Balogun\',\n        avatar: \'\',\n        online: false\n      }\n    ],\n    messages: [\n      {\n        id: \'m-5\',\n        senderId: \'user-bb\',\n        senderName: \'Bayo Balogun\',\n        text: \'I can meet at the library\',\n        timestamp: \'02:11 PM\'\n      }\n    ]\n  },\n  {\n    id: \'chat-4\',\n    title: \'Re: Calculus Textbook\',\n    unreadCount: 0,\n    lastMessageText: \'Thanks for finding it!\',\n    lastMessageTime: \'April 18\',\n    participants: [\n      {\n        id: \'user-ct\',\n        name: \'Chinedu Taylor\',\n        avatar: \'\',\n        online: false\n      }\n    ],\n    messages: [\n      {\n        id: \'m-6\',\n        senderId: \'user-ct\',\n        senderName: \'Chinedu Taylor\',\n        text: \'Thanks for finding it!\',\n        timestamp: \'09:05 AM\'\n      }\n    ]\n  }\n];\n\nexport default function App() {\n  const [currentUser, setCurrentUser] = useState<User | null>(() => {\n    const saved = localStorage.getItem(\'clf_user\');\n    return saved ? JSON.parse(saved) : defaultUser; // Start logged-in as default for dashboard mockup match\n  });\n\n  const [currentTab, setCurrentTab] = useState<string>(\'dashboard\');\n\n  const [items, setItems] = useState<LoggedItem[]>(() => {\n    const saved = localStorage.getItem(\'clf_items\');\n    return saved ? JSON.parse(saved) : initialItems;\n  });\n\n  const [matches, setMatches] = useState<Match[]>(() => {\n    const saved = localStorage.getItem(\'clf_matches\');\n    return saved ? JSON.parse(saved) : initialMatches;\n  });\n\n  const [conversations, setConversations] = useState<Conversation[]>(() => {\n    const saved = localStorage.getItem(\'clf_conversations\');\n    return saved ? JSON.parse(saved) : initialConversations;\n  });\n\n  const [activeConversationId, setActiveConversationId] = useState<string>(\'chat-1\');\n  const [reportType, setReportType] = useState<\'lost\' | \'found\'>(\'lost\');\n\n  // Sync to local storage\n  useEffect(() => {\n    localStorage.setItem(\'clf_user\', currentUser ? JSON.stringify(currentUser) : \'\');\n  }, [currentUser]);\n\n  useEffect(() => {\n    localStorage.setItem(\'clf_items\', JSON.stringify(items));\n  }, [items]);\n\n  useEffect(() => {\n    localStorage.setItem(\'clf_matches\', JSON.stringify(matches));\n  }, [matches]);\n\n  useEffect(() => {\n    localStorage.setItem(\'clf_conversations\', JSON.stringify(conversations));\n  }, [conversations]);\n\n  const handleLogout = () => {\n    setCurrentUser(null);\n    setCurrentTab(\'landing\');\n  };\n\n  const handleLogin = (user: User) => {\n    setCurrentUser(user);\n    setCurrentTab(\'dashboard\');\n  };\n\n  // Unread messages total\n  const unreadMessagesCount = conversations.reduce((acc, conv) => acc + conv.unreadCount, 0);\n\n  // Stats calculation\n  const stats = {\n    lost: items.filter(i => i.type === \'lost\').length * 2 + 120, // multiplied for realism\n    found: items.filter(i => i.type === \'found\').length * 2 + 80,\n    matches: matches.filter(m => m.status === \'confirmed\').length + 284,\n    matchesThisWeek: 28\n  };\n\n  // Confirm match in Matches Tab or Chat Header\n  const handleUpdateMatchStatus = (matchId: string, status: \'confirmed\' | \'rejected\') => {\n    setMatches(prev => prev.map(m => m.id === matchId ? { ...m, status } : m));\n    \n    // Add systems update to relevant chat\n    const targetMatch = matches.find(m => m.id === matchId);\n    if (targetMatch) {\n      setConversations(prev => prev.map(c => {\n        if (c.id === targetMatch.chatId) {\n          const sysMsg: Message = {\n            id: \'sys-\' + Date.now(),\n            senderId: \'system\',\n            senderName: \'System\',\n            text: `[System Update]: Match has been ${status === \'confirmed\' ? \'CONFIRMED\' : \'REJECTED\'} by the user.`,\n            timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n          };\n          return {\n            ...c,\n            lastMessageText: `Match ${status === \'confirmed\' ? \'confirmed\' : \'rejected\'}.`,\n            messages: [...c.messages, sysMsg]\n          };\n        }\n        return c;\n      }));\n    }\n  };\n\n  // Send interactive chat messages with automatic responder replies\n  const handleSendMessage = (conversationId: string, text: string) => {\n    const timeStr = new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n    const userMsg: Message = {\n      id: \'msg-user-\' + Date.now(),\n      senderId: \'me\',\n      senderName: currentUser?.name || \'Mr Alex\',\n      text,\n      timestamp: timeStr\n    };\n\n    setConversations(prev => prev.map(c => {\n      if (c.id === conversationId) {\n        return {\n          ...c,\n          lastMessageText: text,\n          lastMessageTime: \'Just now\',\n          messages: [...c.messages, userMsg]\n        };\n      }\n      return c;\n    }));\n\n    // Trigger mock smart response after 1.2s\n    setTimeout(() => {\n      let replyText = \"Sure! Let\'s meet at one of the recommended safe exchange zones. Does the Library foyer work for you?\";\n      const lower = text.toLowerCase();\n      if (lower.includes(\'hi\') || lower.includes(\'hello\')) {\n        replyText = \"Hey! Let\'s arrange a time to meet up and swap the item. Does tomorrow at 2pm at the library foyer work?\";\n      } else if (lower.includes(\'tomorrow\') || lower.includes(\'time\') || lower.includes(\'meet\') || lower.includes(\'place\')) {\n        replyText = \"Sounds perfect! I will be wearing a red jacket. See you there!\";\n      } else if (lower.includes(\'thank\') || lower.includes(\'thanks\') || lower.includes(\'appreciate\')) {\n        replyText = \"You\'re very welcome! Glad I could help reunite you with your item. Have a wonderful day!\";\n      }\n\n      const replyMsg: Message = {\n        id: \'msg-reply-\' + Date.now(),\n        senderId: \'reply\',\n        senderName: \'Student Finder\',\n        text: replyText,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n      };\n\n      setConversations(prev => prev.map(c => {\n        if (c.id === conversationId) {\n          return {\n            ...c,\n            lastMessageText: replyText,\n            lastMessageTime: \'Just now\',\n            messages: [...c.messages, replyMsg]\n          };\n        }\n        return c;\n      }));\n    }, 1200);\n  };\n\n  // Add reported item\n  const handleAddReport = (itemData: Omit<LoggedItem, \'id\' | \'userId\' | \'status\'>) => {\n    const newItem: LoggedItem = {\n      ...itemData,\n      id: \'item-\' + Date.now(),\n      userId: currentUser?.id || \'guest\',\n      status: \'active\'\n    };\n\n    setItems(prev => [newItem, ...prev]);\n    setCurrentTab(\'dashboard\');\n\n    // Trigger an automatic similarity matching for magic simulation!\n    setTimeout(() => {\n      const matchChance = Math.floor(Math.random() * 20) + 75; // 75% to 95%\n      const mockMatchId = \'match-\' + Date.now();\n      const mockChatId = \'chat-new-\' + Date.now();\n\n      const newMatch: Match = {\n        id: mockMatchId,\n        userItemId: newItem.id,\n        matchedItemId: \'item-mock-remote\',\n        matchedItemTitle: newItem.type === \'lost\' ? `Found: ${newItem.title}` : `Lost: ${newItem.title}`,\n        matchedItemLocation: newItem.location,\n        matchedItemType: newItem.type === \'lost\' ? \'found\' : \'lost\',\n        matchPercentage: matchChance,\n        status: \'pending\',\n        finderName: \'Student Peer\',\n        finderAvatar: \'\',\n        chatId: mockChatId\n      };\n\n      const newConversation: Conversation = {\n        id: mockChatId,\n        title: `Re: ${newItem.title}`,\n        unreadCount: 1,\n        lastMessageText: `Hi there! I think I have your ${newItem.title} or have spotted it!`,\n        lastMessageTime: \'Just now\',\n        participants: [\n          {\n            id: \'user-mock-remote\',\n            name: \'Student Peer\',\n            avatar: \'\',\n            online: true\n          }\n        ],\n        messages: [\n          {\n            id: \'m-mock-1\',\n            senderId: \'user-mock-remote\',\n            senderName: \'Student Peer\',\n            text: `Hi there! I think I have your ${newItem.title} or have spotted it! I posted it earlier. Let me know if we can meet up.`,\n            timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n          }\n        ],\n        matchId: mockMatchId\n      };\n\n      setMatches(prev => [newMatch, ...prev]);\n      setConversations(prev => [newConversation, ...prev]);\n      \n      // Auto open notification indicator\n      const notificationBell = document.getElementById(\'header-notification-bell\');\n      if (notificationBell) {\n        notificationBell.classList.add(\'animate-bounce\');\n        setTimeout(() => notificationBell.classList.remove(\'animate-bounce\'), 2000);\n      }\n    }, 3000);\n  };\n\n  // Open chat from Matches Tab \"Message Finder\"\n  const handleOpenChat = (chatId: string) => {\n    // Check if chat exists, if not make sure it is linked correctly\n    setActiveConversationId(chatId);\n    \n    // Clear unread count\n    setConversations(prev => prev.map(c => c.id === chatId ? { ...c, unreadCount: 0 } : c));\n    \n    setCurrentTab(\'messages\');\n  };\n\n  // Connect from Find Item Tab\n  const handleConnectFromFind = (item: LoggedItem) => {\n    if (!currentUser) {\n      setCurrentTab(\'signin\');\n      return;\n    }\n\n    // Create a new direct chat regarding this public item\n    const chatId = `chat-find-${item.id}`;\n    const existing = conversations.find(c => c.id === chatId);\n    if (existing) {\n      handleOpenChat(chatId);\n      return;\n    }\n\n    const newConversation: Conversation = {\n      id: chatId,\n      title: `Re: ${item.title}`,\n      unreadCount: 0,\n      lastMessageText: `Hi! I\'m interested in coordinating details about: ${item.title}`,\n      lastMessageTime: \'Just now\',\n      participants: [\n        {\n          id: item.userId,\n          name: \'Student Partner\',\n          avatar: \'\',\n          online: false\n        }\n      ],\n      messages: [\n        {\n          id: \'msg-con-\' + Date.now(),\n          senderId: \'me\',\n          senderName: currentUser.name,\n          text: `Hi! I saw your report about the ${item.title} at ${item.location}. I\'d like to check if this is the correct item. Let me know when you\'re available to meet up!`,\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })\n        }\n      ]\n    };\n\n    setConversations(prev => [newConversation, ...prev]);\n    setActiveConversationId(chatId);\n    setCurrentTab(\'messages\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-white flex flex-col justify-between\">\n      <div>\n        {/* Header Navigation */}\n        <Header\n          currentUser={currentUser}\n          currentTab={currentTab}\n          onTabChange={(tab) => {\n            if (!currentUser && (tab === \'dashboard\' || tab === \'messages\' || tab === \'report-lost\' || tab === \'report-found\')) {\n              setCurrentTab(\'signin\');\n            } else {\n              setCurrentTab(tab);\n            }\n          }}\n          onLogout={handleLogout}\n          unreadMessagesCount={unreadMessagesCount}\n        />\n\n        {/* Dynamic Route Switch Panel */}\n        <main className=\"animate-fade-in duration-300\">\n          {currentTab === \'landing\' && (\n            <LandingPage\n              onStartReporting={(type) => {\n                if (!currentUser) {\n                  setCurrentTab(\'signin\');\n                } else {\n                  setReportType(type);\n                  setCurrentTab(type === \'lost\' ? \'report-lost\' : \'report-found\');\n                }\n              }}\n              onNavigateToFind={() => setCurrentTab(\'find-item\')}\n              stats={stats}\n            />\n          )}\n\n          {currentTab === \'dashboard\' && currentUser && (\n            <Dashboard\n              currentUser={currentUser}\n              items={items}\n              matches={matches}\n              onStartReporting={(type) => {\n                setReportType(type);\n                setCurrentTab(type === \'lost\' ? \'report-lost\' : \'report-found\');\n              }}\n              onEditItem={(item) => {\n                alert(`Editing \"${item.title}\" details.`);\n              }}\n              onUpdateMatchStatus={handleUpdateMatchStatus}\n              onOpenChat={handleOpenChat}\n            />\n          )}\n\n          {currentTab === \'messages\' && currentUser && (\n            <Messages\n              conversations={conversations}\n              matches={matches}\n              activeConversationId={activeConversationId}\n              onSelectConversation={(id) => {\n                setActiveConversationId(id);\n                setConversations(prev => prev.map(c => c.id === id ? { ...c, unreadCount: 0 } : c));\n              }}\n              onSendMessage={handleSendMessage}\n              onConfirmMatchInChat={(matchId) => handleUpdateMatchStatus(matchId, \'confirmed\')}\n              onBackToDashboard={() => setCurrentTab(\'dashboard\')}\n            />\n          )}\n\n          {currentTab === \'report-lost\' && currentUser && (\n            <ReportForm\n              type=\"lost\"\n              onCancel={() => setCurrentTab(\'dashboard\')}\n              onSubmit={handleAddReport}\n            />\n          )}\n\n          {currentTab === \'report-found\' && currentUser && (\n            <ReportForm\n              type=\"found\"\n              onCancel={() => setCurrentTab(\'dashboard\')}\n              onSubmit={handleAddReport}\n            />\n          )}\n\n          {currentTab === \'signin\' && (\n            <Auth\n              initialScreen=\"signin\"\n              onAuthSuccess={handleLogin}\n              onSwitchScreen={(screen) => setCurrentTab(screen)}\n            />\n          )}\n\n          {currentTab === \'signup\' && (\n            <Auth\n              initialScreen=\"signup\"\n              onAuthSuccess={handleLogin}\n              onSwitchScreen={(screen) => setCurrentTab(screen)}\n            />\n          )}\n\n          {currentTab === \'about\' && <About />}\n\n          {currentTab === \'find-item\' && (\n            <FindItem\n              currentUser={currentUser}\n              items={items}\n              onConnect={handleConnectFromFind}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Styled Footer Block */}\n      <footer className=\"py-8 bg-white border-t border-gray-100 text-center select-none mt-12\">\n        <p className=\"text-xs text-gray-500 font-medium\">\n          \302\251 2026 Campus Lost and Found (CLF). All rights reserved.\n        </p>\n      </footer>\n    </div>\n  );\n}\n"
    }
